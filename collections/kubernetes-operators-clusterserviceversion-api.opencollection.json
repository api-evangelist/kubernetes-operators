{
  "opencollection": "1.0.0",
  "info": {
    "name": "Operator Lifecycle Manager Cluster Service Version API",
    "version": "0.28.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "ClusterServiceVersion",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List ClusterServiceVersions in a namespace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://kubernetes.default.svc/apis/operators.coreos.com/v1alpha1/namespaces/:namespace/clusterserviceversions",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace name to scope the request."
              },
              {
                "name": "labelSelector",
                "value": "",
                "type": "query",
                "description": "Label selector to filter resources."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              },
              {
                "name": "watch",
                "value": "",
                "type": "query",
                "description": "If true, stream watch events."
              }
            ]
          },
          "docs": "Returns a list of all ClusterServiceVersion resources in the specified namespace. A CSV is the primary operator manifest installed by OLM, containing the operator's deployment spec, RBAC rules, owned CRDs, and metadata."
        },
        {
          "info": {
            "name": "Get a ClusterServiceVersion",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://kubernetes.default.svc/apis/operators.coreos.com/v1alpha1/namespaces/:namespace/clusterserviceversions/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace name to scope the request."
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the OLM resource."
              }
            ]
          },
          "docs": "Returns the specified ClusterServiceVersion including the operator deployment spec, RBAC permissions, owned and required CRDs, install modes, and current phase (Installing, Succeeded, Failed)."
        },
        {
          "info": {
            "name": "Delete a ClusterServiceVersion",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://kubernetes.default.svc/apis/operators.coreos.com/v1alpha1/namespaces/:namespace/clusterserviceversions/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace name to scope the request."
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the OLM resource."
              }
            ]
          },
          "docs": "Deletes the specified ClusterServiceVersion, uninstalling the operator. OLM removes the operator's deployment and RBAC resources. Custom resources managed by the operator are not automatically deleted."
        }
      ]
    }
  ],
  "bundled": true
}