{
  "opencollection": "1.0.0",
  "info": {
    "name": "Operator Lifecycle Manager Install Plan API",
    "version": "0.28.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "InstallPlan",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List InstallPlans in a namespace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://kubernetes.default.svc/apis/operators.coreos.com/v1alpha1/namespaces/:namespace/installplans",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace name to scope the request."
              },
              {
                "name": "labelSelector",
                "value": "",
                "type": "query",
                "description": "Label selector to filter resources."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              },
              {
                "name": "watch",
                "value": "",
                "type": "query",
                "description": "If true, stream watch events."
              }
            ]
          },
          "docs": "Returns a list of all InstallPlan resources in the specified namespace. InstallPlans list the resources OLM will create to install or upgrade an operator. Manual approval plans require an admin to approve them before installation proceeds."
        },
        {
          "info": {
            "name": "Get an InstallPlan",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://kubernetes.default.svc/apis/operators.coreos.com/v1alpha1/namespaces/:namespace/installplans/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace name to scope the request."
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the OLM resource."
              }
            ]
          },
          "docs": "Returns the specified InstallPlan including the list of ClusterServiceVersions and CRDs to be installed, the approval status, and the plan steps."
        },
        {
          "info": {
            "name": "Approve an InstallPlan",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://kubernetes.default.svc/apis/operators.coreos.com/v1alpha1/namespaces/:namespace/installplans/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace name to scope the request."
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the OLM resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Patches the specified InstallPlan to approve it when the approval mode is Manual. Set spec.approved=true to allow OLM to proceed with installation."
        }
      ]
    }
  ],
  "bundled": true
}